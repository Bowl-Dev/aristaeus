# Aristaeus Backend - Local Development
# Uses Docker PostgreSQL container

DATABASE_URL="postgresql://aristaeus:aristaeus@localhost:5433/aristaeus?schema=public"
NODE_ENV=development

# Wompi + admin placeholders (fake values; real keys live in terraform.tfvars)
WOMPI_PUBLIC_KEY=pub_test_local
WOMPI_INTEGRITY_SECRET=test_integrity_local
WOMPI_EVENTS_SECRET=test_events_local
ADMIN_TOKEN=dev-admin-token
