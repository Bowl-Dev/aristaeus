// Aristaeus Database Schema
// Automated Bowl Kitchen System

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Ingredient Catalog
// ============================================

model Ingredient {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(100) // Stable internal identifier (English-based)
  nameEs           String   @map("name_es") @db.VarChar(100)
  nameEn           String   @map("name_en") @db.VarChar(100)
  category         String   @db.VarChar(50) // 'protein', 'base', 'vegetable', 'topping', 'dressing'

  // Nutritional values per 100g
  caloriesPer100g  Decimal  @map("calories_per_100g") @db.Decimal(6, 2)
  proteinGPer100g  Decimal  @map("protein_g_per_100g") @db.Decimal(5, 2)
  carbsGPer100g    Decimal  @map("carbs_g_per_100g") @db.Decimal(5, 2)
  fatGPer100g      Decimal  @map("fat_g_per_100g") @db.Decimal(5, 2)
  fiberGPer100g    Decimal? @map("fiber_g_per_100g") @db.Decimal(5, 2)

  // Operational
  available        Boolean  @default(true)
  displayOrder     Int?     @map("display_order")

  // Product imagery (S3-hosted)
  imageUrl         String?  @map("image_url")

  // Timestamps
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  orderItems       OrderItem[]
  menuItems        MenuIngredient[]

  //Price
  pricePerG        Decimal  @default(0.0) @map("price_per_g") @db.Decimal(5, 2)

  @@map("ingredients")
}

// ============================================
// Menu Catalog
// ============================================

model Menu {
  id            Int              @id @default(autoincrement())
  nameEs        String           @map("name_es") @db.VarChar(200)
  nameEn        String           @map("name_en") @db.VarChar(200)
  descriptionEs String           @map("description_es") @db.Text
  descriptionEn String           @map("description_en") @db.Text
  bowlSize      Int              @map("bowl_size")
  active        Boolean          @default(true)
  displayOrder  Int?             @map("display_order")
  imageUrl      String?          @map("image_url")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  ingredients   MenuIngredient[]

  @@map("menus")
}

model MenuIngredient {
  id            Int        @id @default(autoincrement())
  menuId        Int        @map("menu_id")
  ingredientId  Int        @map("ingredient_id")
  quantityGrams Decimal    @map("quantity_grams") @db.Decimal(7, 2)
  sequenceOrder Int        @map("sequence_order")
  menu          Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([menuId])
  @@map("menu_ingredients")
}

// ============================================
// User (Customer) Information
// ============================================

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  phone         String   @unique @db.VarChar(20)
  email         String?  @db.VarChar(255)

  // Timestamps
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  addresses     Address[]
  orders        Order[]
  checkouts     Checkout[]

  @@map("users")
}

// ============================================
// Address (Colombian, one-to-many from User)
// ============================================

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Colombian address (structured)
  streetAddress String   @map("street_address") @db.VarChar(200)
  neighborhood  String   @db.VarChar(100)
  city          String   @db.VarChar(100)
  department    String   @db.VarChar(100)
  postalCode    String?  @map("postal_code") @db.VarChar(6)

  // Timestamps
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  orders        Order[]

  @@index([userId])
  @@map("addresses")
}

// ============================================
// Order Header
// ============================================

model Order {
  id              Int       @id @default(autoincrement())

  // User reference
  userId          String    @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Address reference (nullable; snapshot below preserves history if address is deleted)
  addressId       String?   @map("address_id") @db.Uuid
  address         Address?  @relation(fields: [addressId], references: [id], onDelete: SetNull)

  // Delivery address snapshot (captured at order time)
  deliveryStreetAddress String? @map("delivery_street_address") @db.VarChar(200)
  deliveryNeighborhood  String? @map("delivery_neighborhood") @db.VarChar(100)
  deliveryCity          String? @map("delivery_city") @db.VarChar(100)
  deliveryDepartment    String? @map("delivery_department") @db.VarChar(100)
  deliveryPostalCode    String? @map("delivery_postal_code") @db.VarChar(6)

  // Delivery instructions (per-order)
  deliveryInstructions  String? @map("delivery_instructions") @db.VarChar(500)

  // Bowl configuration
  bowlSize        Int       @map("bowl_size") // 250, 450, or 600 grams

  // Status lifecycle
  // awaiting_payment -> pending -> preparing -> ready -> completed
  // Possible: cancelled, failed, payment_failed
  status          String    @default("pending") @db.VarChar(50)

  // Cutlery preference
  includeCutlery  Boolean   @default(false) @map("include_cutlery")

  // Nutritional summary (calculated from order_items)
  totalCalories   Decimal?  @map("total_calories") @db.Decimal(7, 2)
  totalProteinG   Decimal?  @map("total_protein_g") @db.Decimal(6, 2)
  totalCarbsG     Decimal?  @map("total_carbs_g") @db.Decimal(6, 2)
  totalFatG       Decimal?  @map("total_fat_g") @db.Decimal(6, 2)
  totalFiberG     Decimal?  @map("total_fiber_g") @db.Decimal(6, 2)
  totalWeightG    Decimal?  @map("total_weight_g") @db.Decimal(7, 2)

  // Price to charge to the customer
  totalPrice      Decimal?  @map("total_price") @db.Decimal(7, 2)

  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  assignedAt      DateTime? @map("assigned_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")

  // The checkout (Wompi payment) this order belongs to; null for pre-checkout orders
  checkoutId      String?   @map("checkout_id") @db.Uuid
  checkout        Checkout? @relation(fields: [checkoutId], references: [id])

  // Relations
  items           OrderItem[]

  @@index([status])
  @@index([userId])
  @@index([addressId])
  @@index([checkoutId])
  @@map("orders")
}

// ============================================
// Order Line Items
// ============================================

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int      @map("order_id")
  ingredientId  Int      @map("ingredient_id")

  quantityGrams Decimal  @map("quantity_grams") @db.Decimal(7, 2)

  // Assembly sequence (1, 2, 3... for kitchen assembly order)
  sequenceOrder Int      @map("sequence_order")

  // Timestamps
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ============================================
// Store Configuration (Singleton)
// ============================================

model StoreConfig {
  id           Int      @id @default(1)
  ordersPaused Boolean  @default(false) @map("orders_paused")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("store_config")
}

// ============================================
// Delivery Cost Estimation
// ============================================

/// Cached cadastral geocoding results, keyed by normalised address.
/// The cadastral service has no SLA, so a repeat address must never re-query it.
model GeocodeCache {
  id            Int      @id @default(autoincrement())
  addressKey    String   @unique @map("address_key") @db.VarChar(200)

  lat           Decimal  @db.Decimal(10, 7)
  lng           Decimal  @db.Decimal(10, 7)

  /// 'exact' | 'nearest_number' | 'nearest_cross' | 'street_segment'
  matchTier     String   @map("match_tier") @db.VarChar(30)
  /// The PDONVIAL / PDOTEXTO plate actually matched, for display and audit.
  resolvedPlate String?  @map("resolved_plate") @db.VarChar(120)

  fetchedAt     DateTime @default(now()) @map("fetched_at")

  @@map("geocode_cache")
}

/// A delivery whose real third-party courier charge we know. This is the
/// model's training data — shared server-side rather than trapped in one
/// operator's localStorage.
model DeliveryObservation {
  id          Int      @id @default(autoincrement())

  /// Address as the operator typed it.
  rawAddress  String   @map("raw_address") @db.VarChar(255)
  /// Parsed components, in the cadastre's vocabulary.
  prefix      String   @db.VarChar(4)
  street      String   @db.VarChar(20)
  cross       String   @db.VarChar(20)
  number      Int

  /// Geocoded position. Null when geocoding failed for this row.
  lat         Decimal? @db.Decimal(10, 7)
  lng         Decimal? @db.Decimal(10, 7)
  matchTier   String?  @map("match_tier") @db.VarChar(30)

  /// Grid-aligned legs from the kitchen, in km. Denormalised for inspection;
  /// the fit recomputes them from lat/lng when those are present.
  northKm     Decimal? @map("north_km") @db.Decimal(8, 4)
  eastKm      Decimal? @map("east_km") @db.Decimal(8, 4)

  /// What the courier actually charged, in COP. Ground truth.
  actualCost  Int      @map("actual_cost")

  /// 'seed' (Ops history) or 'correction' (operator-entered).
  source      String   @default("correction") @db.VarChar(20)

  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@index([source])
  @@map("delivery_observations")
}

// ============================================
// Promotional Coupons
// ============================================

model Coupon {
  id                Int      @id @default(autoincrement())

  // Identity (see the coupons spec doc, section 5)
  code              String   @unique @db.VarChar(40) // stored and compared uppercase
  campaignName      String   @map("campaign_name") @db.VarChar(200)
  description       String?  @db.Text // internal note for Marketing

  // Benefit. 'percent' uses value as 0-100, 'fixed' as COP,
  // 'free_shipping' ignores it and discounts the delivery fee instead.
  type              String   @db.VarChar(20)
  value             Decimal? @db.Decimal(10, 2)

  // Vigencia
  startsAt          DateTime @map("starts_at")
  endsAt            DateTime @map("ends_at")

  // Presupuesto. Every redemption draws down budgetRemaining by the COP actually
  // granted; at zero the coupon stops validating.
  budgetTotal       Decimal  @map("budget_total") @db.Decimal(12, 2)
  budgetRemaining   Decimal  @map("budget_remaining") @db.Decimal(12, 2)

  // Reglas de negocio. Two rules, so two columns.
  minBowls          Int      @default(1) @map("min_bowls")
  firstPurchaseOnly Boolean  @default(false) @map("first_purchase_only")

  // Estado — the manual Marketing on/off switch. Expiry and an exhausted budget
  // are derived at validation time, so nothing depends on a job having run.
  active            Boolean  @default(true)

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  checkouts         Checkout[]

  @@index([active])
  @@map("coupons")
}

// ============================================
// Checkout (one Wompi payment for N orders)
// ============================================

model Checkout {
  id            String    @id @default(uuid()) @db.Uuid // also the Wompi reference
  /// Null once the customer deletes their data (Law 1581): the amounts stay so coupon history adds up.
  userId        String?   @map("user_id") @db.Uuid
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Shown as AG-####. The sequence starts at 1000 (see the migration).
  orderNumber   Int       @unique @default(autoincrement()) @map("order_number")

  // Integer COP. total = subtotal + deliveryFee - discount + serviceFee
  subtotal      Int
  deliveryFee   Int       @map("delivery_fee")
  discount      Int       @default(0)
  serviceFee    Int       @map("service_fee")
  total         Int

  couponId      Int?      @map("coupon_id")
  coupon        Coupon?   @relation(fields: [couponId], references: [id])

  /// 'awaiting_payment' | 'paid' | 'payment_failed'
  paymentStatus String    @default("awaiting_payment") @map("payment_status") @db.VarChar(30)
  wompiTxId     String?   @map("wompi_tx_id") @db.VarChar(64)
  paymentMethod String?   @map("payment_method") @db.VarChar(30)
  paidAt        DateTime? @map("paid_at")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  orders        Order[]

  @@index([userId])
  @@index([couponId, paymentStatus])
  @@map("checkouts")
}
